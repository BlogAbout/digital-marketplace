    "@mui/material": "^9.3.1",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "laravel-echo": "^2.4.0",
    "pusher-js": "^8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
